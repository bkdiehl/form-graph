{
	"name": "form-graph",
	"version": "0.3.0",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run prepack",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit -p tsconfig.lib.json",
		"typecheck:v1": "tsc --noEmit -p tsconfig.v1.json",
		"prepublishOnly": "pnpm run typecheck && pnpm run check && vitest run",
		"release": "npm version patch && pnpm publish && git push --follow-tags",
		"release:minor": "npm version minor && pnpm publish && git push --follow-tags",
		"release:major": "npm version major && pnpm publish && git push --follow-tags",
		"docs:api": "typedoc",
		"check:types-budget": "node scripts/type-budget.mjs"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*",
		"!dist/**/__tests__",
		"!dist/__tests__",
		"!dist/__bench__",
		"!dist/__stress__",
		"!dist/__fixtures__",
		"!dist/generation",
		"!dist/codecs"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./svelte": {
			"types": "./dist/svelte/index.d.ts",
			"svelte": "./dist/svelte/index.js",
			"import": "./dist/svelte/index.js",
			"default": "./dist/svelte/index.js"
		},
		"./react": {
			"types": "./dist/react/index.d.ts",
			"import": "./dist/react/index.js",
			"default": "./dist/react/index.js"
		},
		"./defs": {
			"types": "./dist/defs/index.d.ts",
			"import": "./dist/defs/index.js",
			"default": "./dist/defs/index.js"
		}
	},
	"peerDependencies": {
		"react": "^18.0.0 || ^19.0.0",
		"svelte": "^5.0.0",
		"zod": "^3.25.0 || ^4.0.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/react": "^16.3.2",
		"@types/lodash-es": "^4.17.12",
		"@types/node": "^26.4.0",
		"@types/react": "^18.3.31",
		"@types/react-dom": "^18.3.7",
		"@vitejs/plugin-react": "^6.1.0",
		"happy-dom": "^20.11.7",
		"lodash-es": "^4.18.1",
		"publint": "^0.3.21",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"shiki": "^4.4.3",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.3",
		"typedoc": "^0.28.20",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vite-node": "^6.0.0",
		"vitest": "^4.1.11",
		"zod": "^4.4.3"
	},
	"keywords": [
		"forms",
		"form",
		"state",
		"zod",
		"discriminated-union",
		"svelte",
		"react",
		"validation",
		"isomorphic"
	],
	"peerDependenciesMeta": {
		"svelte": {
			"optional": true
		},
		"react": {
			"optional": true
		},
		"zod": {
			"optional": true
		}
	},
	"description": "Branch-routed forms with one definition, both sides: a contract engine for forms whose shape depends on their own values.",
	"license": "MIT",
	"author": "Briant Diehl (https://github.com/bkdiehl)",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bkdiehl/form-graph.git"
	},
	"homepage": "https://github.com/bkdiehl/form-graph#readme",
	"bugs": {
		"url": "https://github.com/bkdiehl/form-graph/issues"
	},
	"engines": {
		"node": ">=20"
	},
	"packageManager": "pnpm@10.34.4"
}
