{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "types": [
      "vitest/globals",
      "node"
    ],
    "paths": {
      "~/*": [
        "./src/v1/civitai/*"
      ]
    }
  },
  "include": [
    "src/lib",
    "src/v1/__tests__",
    "src/v1/civitai/globals.d.ts"
  ]
}
